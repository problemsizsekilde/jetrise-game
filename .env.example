PORT=3001

# 1-ci Bot: ADMIN BOT (Depozit/Çıxarış təsdiqi + /ver, /al, /istifadeciler)
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_telegram_id_here

# 2-ci Bot: SİQNAL BOT (Müştərilər üçün "Siqnal Al" botu)
TELEGRAM_SIGNAL_BOT_TOKEN=your_signal_bot_token_here
TELEGRAM_ADMIN_CONTACT=@your_admin_username
SIGNAL_ACCESS_PRICE_AZN=55
SIGNAL_TEST_PRICE_AZN=2
SIGNAL_COOLDOWN_SECONDS=12

# Rejim: polling və ya webhook
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=change_me
